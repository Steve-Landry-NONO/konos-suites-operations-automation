      "parameters": {
        "jsCode": "\nfunction title(p){return (p?.title??[]).map(x=>x.plain_text??x.text?.content??'').join('')}\nfunction text(p){return (p?.rich_text??[]).map(x=>x.plain_text??x.text?.content??'').join('')}\nfunction num(p){return typeof p?.number==='number'?p.number:0}\nfunction chk(p){return !!p?.checkbox}\nfunction sel(p){return p?.select?.name??''}\nfunction dateStart(p){return p?.date?.start??''}\nfunction rel(p){return (p?.relation??[]).map(x=>x.id)}\nreturn ($json.results??[]).map(r=>{const p=r.properties??{};const payload={arrival:dateStart(p['Arrivée']),departure:dateStart(p['Départ']),travelers:num(p['Voyageurs']),adults:num(p['Adultes']),children:num(p['Enfants']),nights:num(p['Nb nuits']),bedding:sel(p['Couchages']),separate_beds:chk(p['Demande couchages séparés']),bedroom_bed:chk(p['Lit chambre requis']),sofa_bed:chk(p['Canapé-lit requis']),bedroom_sets:num(p['Jeux chambre requis']),sofa_sets:num(p['Jeux canapé requis']),towels:num(p['Serviettes']),pillowcases:num(p['Taies requises']),bathmats:num(p['Tapis bain requis']),towels_kitchen:num(p['Torchons requis']),water:num(p['Bouteilles eau requises']),coffee:num(p['Capsules T-disc requises']),wc_rolls:num(p['Rouleaux WC prévus']),kitchen_bags:num(p['Sacs cuisine prévus']),wc_bags:num(p['Sacs WC prévus']),arrival_time:text(p['Heure arrivée validée'])||text(p['Heure arrivée prévue']),departure_time:text(p['Heure départ prévue']),particularities:text(p['Particularités'])};const fingerprint=JSON.stringify(payload);const oldFingerprint=text(p['Empreinte besoins appliquée']);return {json:{reservation_page_id:r.id,reservation_name:title(p['Réservation'])||r.id,reservation_status:sel(p['Statut réservation']),intervention_ids:rel(p['Interventions']),fingerprint,old_fingerprint:oldFingerprint,changed:fingerprint!==oldFingerprint,...payload}};});\n"
      },
