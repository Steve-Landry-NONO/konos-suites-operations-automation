    {
      "parameters": {
        "jsCode": "function title(p){return(p?.title??[]).map(x=>x.plain_text??x.text?.content??'').join('')}function num(p){if(!p)return 0;if(typeof p.number==='number')return p.number;if(typeof p.formula?.number==='number')return p.formula.number;if(typeof p.rollup?.number==='number')return p.rollup.number;return 0}function txt(p){return(p?.rich_text??[]).map(x=>x.plain_text??x.text?.content??'').join('')}function sel(p){return p?.select?.name??''}return($json.results??[]).map(page=>{const p=page.properties??{},a=title(p.Article)||page.id,current=num(p['Stock physique calculé'])||num(p['Stock initial']),reserved=num(p['Stock réservé calculé'])||num(p.Réservé),avail=num(p['Stock disponible']),th=num(p['Seuil minimum']),target=num(p['Stock cible'])||th,crit=num(p['Stock critique']),qty=Math.max(0,Math.ceil(target-avail)),price=num(p['Prix unitaire estimé']);return{json:{domain:'Consommable',article:a,article_page_id:page.id,stock_current:current,stock_reserved:reserved,stock_available:avail,threshold:th,target,quantity_to_buy:qty,unit:sel(p.Unité),unit_price:price,budget:qty*price,store:sel(p.Magasin)||txt(p['Fournisseur habituel']),purchase_link:p['Lien achat']?.url??'',priority:avail<=crit||avail<=0?'Critique':'Haute',shortage:avail<=th,automation_id:'stock:consommable:'+page.id.replaceAll('-','')}}})"
      },
