        "jsCode": "const x=$json,now=new Date().toISOString().slice(0,10),deadline=new Date(Date.now()+(x.priority==='Critique'?24:72)*3600000).toISOString().slice(0,10);const p={\"Alerte\":{title:[{type:'text',text:{content:`${x.priority} — ${x.article}`}}]},\"Domaine\":{select:{name:x.domain}},\"Article\":{rich_text:[{type:'text',text:{content:x.article}}]},\"Stock actuel\":{number:x.stock_current},\"Stock réservé\":{number:x.stock_reserved},\"Stock disponible\":{number:x.stock_available},\"Seuil minimum\":{number:x.threshold},\"Stock cible\":{number:x.target},\"Quantité à acheter\":{number:x.quantity_to_buy},\"Unité\":{rich_text:[{type:'text',text:{content:x.unit||'unité'}}]},\"Prix unitaire estimé\":{number:x.unit_price},\"Budget estimé\":{number:x.budget},\"Magasin\":{rich_text:[{type:'text',text:{content:x.store||''}}]},\"Priorité\":{select:{name:x.priority}},\"Statut\":{select:{name:'À acheter'}},\"Date détection\":{date:{start:now}},\"Date limite\":{date:{start:deadline}},\"Source\":{select:{name:'Stock actuel'}},\"ID automatisation\":{rich_text:[{type:'text',text:{content:x.automation_id}}]},\"Dernier recalcul\":{date:{start:now}},\"Commentaire\":{rich_text:[{type:'text',text:{content:`Stock disponible ${x.stock_available}, seuil ${x.threshold}, cible ${x.target}.`}}]}};if(x.purchase_link)p['Lien achat']={url:x.purchase_link};if(x.domain==='Consommable')p['Article consommable']={relation:[{id:x.article_page_id}]};else p['Article linge']={relation:[{id:x.article_page_id}]};return[{json:{...x,request_body:JSON.stringify({parent:{data_source_id:'041a8c85-2df0-4fa2-ae8b-aaa194daba97'},properties:p})}}];"
