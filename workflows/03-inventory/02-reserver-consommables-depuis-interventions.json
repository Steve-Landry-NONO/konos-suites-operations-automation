        "url": "https://api.notion.com/v1/data_sources/71cb042a-8768-4afa-be06-45895e262b0b/query",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2026-03-11"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\"page_size\":100,\"filter\":{\"and\":[{\"property\":\"Validation réservation\",\"checkbox\":{\"equals\":true}},{\"property\":\"Statut\",\"select\":{\"does_not_equal\":\"Annulée\"}},{\"property\":\"Statut\",\"select\":{\"does_not_equal\":\"Terminée\"}}]}}",
        "options": {}
      },
      "id": "d22129ff-207a-4ebc-9280-38cbe7ce9c33",
      "name": "Lire interventions actives",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1520,
        32
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "nEXSVkeOTN9rwZBZ",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "function title(p){return p?.title?.map(x=>x.plain_text??x.text?.content??'').join('')??'';}\nfunction num(p){return p?.number??0;}\nfunction dateStart(p){return p?.date?.start??new Date().toISOString().slice(0,10);}\nconst mappings=[[\"Bouteilles eau à installer\", \"Bouteille d’eau 50 cl\", \"eau-50cl\"], [\"Capsules T-disc à installer\", \"Capsules de café\", \"capsules-cafe\"], [\"Rouleaux WC à installer\", \"Papier toilette\", \"papier-toilette\"], [\"Sacs cuisine à prévoir\", \"Sacs-poubelle cuisine\", \"sacs-cuisine\"], [\"Sacs WC à prévoir\", \"Sacs-poubelle WC\", \"sacs-wc\"]];\nconst out=[];\nfor(const page of ($json.results??[])){const p=page.properties;const compact=page.id.replaceAll('-','');const iname=title(p['Intervention'])||page.id;for(const [field,article,slug] of mappings){const q=num(p[field]);if(q<=0)continue;out.push({json:{intervention_page_id:page.id,intervention_name:iname,date_mouvement:dateStart(p['Date intervention']),article_name:article,quantity:q,automation_id:'consommables-reservation:'+compact+':'+slug},pairedItem:{item:0}});}}\nreturn out;"
      },
