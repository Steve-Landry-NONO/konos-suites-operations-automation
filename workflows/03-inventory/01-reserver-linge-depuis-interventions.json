      "id": "8e0275dc-51b3-415a-ac51-ba5ac0636d51",
      "name": "Lire interventions actives",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1728,
        64
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "nEXSVkeOTN9rwZBZ",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "function title(p){return p?.title?.map(x=>x.plain_text??x.text?.content??'').join('')??'';}\nfunction num(p){return p?.number??0;}\nfunction dateStart(p){return p?.date?.start??new Date().toISOString().slice(0,10);}\nconst mappings=[[\"Jeux chambre à prendre\", \"Jeu lit principal\", \"jeu-lit-principal\"], [\"Jeux canapé à prendre\", \"Jeu canapé-lit\", \"jeu-canape-lit\"], [\"Taies à prendre\", \"Taie d’oreiller\", \"taie-oreiller\"], [\"Serviettes à prendre\", \"Grande serviette\", \"grande-serviette\"], [\"Tapis bain à prendre\", \"Tapis de bain\", \"tapis-bain\"], [\"Torchons à prendre\", \"Torchon cuisine\", \"torchon-cuisine\"]];\nconst out=[];\nfor(const page of ($json.results??[])){const p=page.properties;const compact=page.id.replaceAll('-','');const iname=title(p['Intervention'])||page.id;for(const [field,article,slug] of mappings){const q=num(p[field]);if(q<=0)continue;out.push({json:{intervention_page_id:page.id,intervention_name:iname,date_mouvement:dateStart(p['Date intervention']),article_name:article,quantity:q,automation_id:'linge-reservation:'+compact+':'+slug},pairedItem:{item:0}});}}\nreturn out;"
      },
