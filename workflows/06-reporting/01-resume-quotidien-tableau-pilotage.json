        "jsCode": "const arr=$('Lire arrivées').item.json.results??[];const dep=$('Lire départs').item.json.results??[];const ano=$('Lire réservations en anomalie').item.json.results??[];const mis=$('Lire missions du jour').item.json.results??[];const stk=$('Lire alertes stock').item.json.results??[];const cyc=$('Lire cycles lessive ouverts').item.json.results??[];const today=$('Préparer dates').item.json.today;const summary=`Arrivées: ${arr.length} | Départs: ${dep.length} | Missions: ${mis.length} | Réservations en anomalie: ${ano.length} | Achats stock: ${stk.length} | Cycles lessive ouverts: ${cyc.length}`;const detail=[`ARRIVÉES DU JOUR: ${arr.length}`,`DÉPARTS DU JOUR: ${dep.length}`,`MISSIONS DU JOUR: ${mis.length}`,`ANOMALIES AVANT ARRIVÉE: ${ano.length}`,`ARTICLES À ACHETER: ${stk.length}`,`CYCLES LESSIVE OUVERTS: ${cyc.length}`].join('\\n');return [{json:{today,summary,detail,critical:ano.length>0||stk.length>0,automation_id:'daily-summary:'+today}}];"
