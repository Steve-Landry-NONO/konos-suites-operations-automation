    {
      "parameters": {
        "jsCode": "\nconst ctx=$('Analyser intervention').item.json;\nconst missionResults=$('Chercher mission intervenante').item.json.results??[];\nconst linenResults=$('Chercher réservations linge').item.json.results??[];\nconst consResults=$('Chercher réservations consommables').item.json.results??[];\n\nconst anomalies=[];\nlet passed=0;\nconst checks=8;\n\nif(ctx.has_intervention) passed++; else anomalies.push('Aucune intervention liée');\nif(['À planifier','Planifiée','En cours','Terminée'].includes(ctx.intervention_status)) passed++; else anomalies.push('Statut intervention incompatible : '+(ctx.intervention_status||'vide'));\nif(missionResults.length>0) passed++; else anomalies.push('Aucune mission intervenante');\nif(linenResults.length>0) passed++; else anomalies.push('Aucune réservation prévisionnelle de linge');\nif(consResults.length>0) passed++; else anomalies.push('Aucune réservation prévisionnelle de consommables');\nif(ctx.recalculation_status!=='Bloqué') passed++; else anomalies.push('Recalcul des besoins bloqué');\nif(!ctx.automation_error && !ctx.intervention_error) passed++; else anomalies.push('Erreur automatisation présente');\nif(ctx.complete_details) passed++; else anomalies.push('Détails de réservation incomplets');\n\nconst score=Math.round((passed/checks)*100);\nconst ready=anomalies.length===0;\nreturn [{json:{...ctx,\n  mission_count:missionResults.length,\n  linen_reservation_count:linenResults.length,\n  consumable_reservation_count:consResults.length,\n  anomalies,\n  score,\n  ready\n}}];\n"
      },
      "id": "cee69f50-caf1-4251-90fa-f29db3783532",
      "name": "Calculer score préparation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst x=$json;\nconst today=new Date().toISOString().slice(0,10);\nconst control=x.ready?'Prêt':'Anomalie';\nconst operational=x.ready?'Prêt':'Problème';\nconst body={properties:{\n  'Contrôle avant arrivée':{select:{name:control}},\n  'Dernier contrôle avant arrivée':{date:{start:today}},\n  'Anomalies avant arrivée':{rich_text:x.anomalies.length?[{type:'text',text:{content:x.anomalies.join(' | ')}}]:[]},\n  'Score préparation':{number:x.score},\n  'Statut opérationnel':{select:{name:operational}}\n}};\nreturn [{json:{...x,request_body:JSON.stringify(body)}}];\n"
      },
