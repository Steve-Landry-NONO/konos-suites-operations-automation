    {
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/data_sources/a6770a38-9710-4026-bd17-4d0937093c3c/query",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2026-03-11"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({\n  page_size: 100,\n  filter: {\n    and: [\n      {property:'Validation admin',checkbox:{equals:true}},\n      {property:'Statut réservation',select:{equals:'Confirmée'}},\n      {property:'Arrivée',date:{on_or_after:$json.today}},\n      {property:'Arrivée',date:{on_or_before:$json.end_date}}\n    ]\n  },\n  sorts:[{property:'Arrivée',direction:'ascending'}]\n}) }}",
        "options": {}
      },
      "id": "6f10b0df-19a8-4608-ba99-325d5608adf8",
      "name": "Lire réservations à contrôler",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1472,
        208
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "nEXSVkeOTN9rwZBZ",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nfunction title(p){return (p?.title??[]).map(x=>x.plain_text??x.text?.content??'').join('')}\nfunction text(p){return (p?.rich_text??[]).map(x=>x.plain_text??x.text?.content??'').join('')}\nfunction sel(p){return p?.select?.name??''}\nfunction chk(p){return !!p?.checkbox}\nfunction dateStart(p){return p?.date?.start??''}\nfunction rel(p){return (p?.relation??[]).map(x=>x.id)}\n\nreturn ($json.results??[]).map(r=>{\n  const p=r.properties??{};\n  return {json:{\n    reservation_page_id:r.id,\n    reservation_name:title(p['Réservation'])||r.id,\n    arrival:dateStart(p['Arrivée']),\n    operational_status:sel(p['Statut opérationnel']),\n    intervention_ids:rel(p['Interventions']),\n    recalculation_status:sel(p['Statut recalcul besoins']),\n    automation_error:text(p['Erreur automatisation']),\n    complete_details:chk(p['Détails complets reçus']),\n    message_checkin:chk(p['Message check-in'])\n  }};\n});\n"
      },
