    {
      "parameters": {
        "jsCode": "function text(prop) { return prop?.rich_text?.map(x => x.plain_text ?? x.text?.content ?? '').join('') ?? ''; }\nfunction title(prop) { return prop?.title?.map(x => x.plain_text ?? x.text?.content ?? '').join('') ?? ''; }\nfunction number(prop) { return prop?.number ?? 0; }\nfunction checkbox(prop) { return !!prop?.checkbox; }\nfunction select(prop) { return prop?.select?.name ?? ''; }\nfunction dateStart(prop) { return prop?.date?.start ?? null; }\nconst statusMap = {'À générer':'À préparer','À planifier':'À préparer','Planifiée':'À préparer','En cours':'En cours','En attente':'Bloquée','Terminée':'Terminée','Annulée':'Annulée','Problème':'Bloquée'};\nreturn ($json.results ?? []).map((page) => {\n const p = page.properties; const sourceId = page.id.replaceAll('-', ''); const statutInterne = select(p['Statut']); const incident = checkbox(p['Incident constaté']);\n const instructions = [text(p['Demandes particulières']), text(p['Contrainte horaire']), text(p['Arrivée voyageur validée']) ? `Arrivée validée : ${text(p['Arrivée voyageur validée'])}` : ''].filter(Boolean).join(' ');\n const missionProperties = {\n  'Mission': {title:[{text:{content:title(p['Intervention']) || `Intervention ${sourceId}`}}]},\n  'Date intervention': {date: dateStart(p['Date intervention']) ? {start:dateStart(p['Date intervention'])} : null},\n  'Heure prévue': {rich_text:[{text:{content:text(p['Heure début prévue'])}}]},\n  'Statut': {select:{name:statusMap[statutInterne] ?? 'À préparer'}},\n  'Priorité': {select:{name:select(p['Priorité']) === 'Basse' ? 'Normale' : (select(p['Priorité']) || 'Normale')}},\n  'Voyageurs': {number:number(p['Nb voyageurs'])},\n  'Lit chambre requis': {checkbox:checkbox(p['Lit chambre à préparer'])},\n  'Canapé-lit requis': {checkbox:checkbox(p['Canapé-lit à préparer'])},\n  'Jeux chambre requis': {number:number(p['Jeux chambre à prendre'])},\n  'Jeux canapé requis': {number:number(p['Jeux canapé à prendre'])},\n  'Taies requises': {number:number(p['Taies à prendre'])},\n  'Grandes serviettes requises': {number:number(p['Serviettes à prendre'])},\n  'Tapis bain requis': {number:number(p['Tapis bain à prendre'])},\n  'Torchons requis': {number:number(p['Torchons à prendre'])},\n  'Bouteilles eau requises': {number:number(p['Bouteilles eau à installer'])},\n  'Capsules café requises': {number:number(p['Capsules T-disc à installer'])},\n  'Rouleaux WC prévus': {number:number(p['Rouleaux WC à installer'])},\n  'Sacs cuisine prévus': {number:number(p['Sacs cuisine à prévoir'])},\n  'Sacs WC prévus': {number:number(p['Sacs WC à prévoir'])},\n  'Instructions particulières': {rich_text:[{text:{content:instructions}}]},\n  'Incident': {checkbox:incident},\n  'Type incident': incident && select(p['Type incident']) !== 'Aucun' ? {select:{name:select(p['Type incident'])}} : {select:null},\n  'Description incident': {rich_text:[{text:{content:text(p['Description incident'])}}]},\n  'Notes intervenante': {rich_text:[{text:{content:text(p['Compte rendu'])}}]},\n  'ID intervention source': {rich_text:[{text:{content:sourceId}}]},\n  'Source': {select:{name:'n8n'}},\n  'Dernière synchronisation': {date:{start:new Date().toISOString()}}\n };\n if (!dateStart(p['Date intervention'])) delete missionProperties['Date intervention'];\n return {json:{source_page_id:page.id,source_id_compact:sourceId,mission_properties:missionProperties,source_last_edited_time:page.last_edited_time},pairedItem:{item:0}};\n});"
      },
