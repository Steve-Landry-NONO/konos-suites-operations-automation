        "jsCode": "function title(p){return (p?.title??[]).map(x=>x.plain_text??'').join('')}function text(p){return (p?.rich_text??[]).map(x=>x.plain_text??'').join('')}function sel(p){return p?.select?.name??''}function num(p){return typeof p?.number==='number'?p.number:0}function date(p){return p?.date?.start??''}return ($json.results??[]).map(r=>{const p=r.properties??{};const arrival=date(p.Arrivée);const id='not-ready:'+r.id.replaceAll('-','')+':'+arrival;return {json:{reservation_id:r.id,name:title(p.Réservation)||r.id,arrival,score:num(p['Score préparation']),details:text(p['Anomalies avant arrivée'])||'Contrôle avant arrivée non validé',control:sel(p['Contrôle avant arrivée']),automation_id:id}}});"
