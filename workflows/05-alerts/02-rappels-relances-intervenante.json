        "jsCode": "function title(p){return (p?.title??[]).map(x=>x.plain_text??'').join('')}function text(p){return (p?.rich_text??[]).map(x=>x.plain_text??'').join('')}function date(p){return p?.date?.start??''}function sel(p){return p?.select?.name??''}return ($json.results??[]).map(m=>{const p=m.properties??{};const d=date(p['Date intervention']);const id='mission-reminder:'+m.id.replaceAll('-','')+':'+d;return {json:{mission_id:m.id,mission:title(p.Mission)||m.id,date:d,time:text(p['Heure prévue']),status:sel(p.Statut),automation_id:id}}});"
