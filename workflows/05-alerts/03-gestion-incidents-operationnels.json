    {
      "parameters": {
        "jsCode": "const x=$json;const today=new Date().toISOString().slice(0,10);const props={'Alerte':{title:[{type:'text',text:{content:`Incident ${x.type} — ${x.name}`}}]},'Type':{select:{name:'Incident'}},'Priorité':{select:{name:['Dégât','Accès'].includes(x.type)?'Critique':'Haute'}},'Statut':{select:{name:'Ouverte'}},'Date détection':{date:{start:today}},'Intervention':{relation:[{id:x.intervention_id}]},'Description':{rich_text:[{type:'text',text:{content:x.description}}]},'Action attendue':{rich_text:[{type:'text',text:{content:x.action}}]},'Destinataire':{rich_text:[{type:'text',text:{content:'Steve'}}]},'ID automatisation':{rich_text:[{type:'text',text:{content:x.automation_id}}]},'Dernière mise à jour':{date:{start:today}}};if(x.reservation_ids.length)props['Réservation']={relation:x.reservation_ids.map(id=>({id}))};return [{json:{...x,request_body:JSON.stringify({parent:{data_source_id:'447f7d6b-5b4e-4005-a861-9b91caf4bcda'},properties:props})}}];"
      },
