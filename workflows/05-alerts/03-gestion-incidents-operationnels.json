    {
      "parameters": {
        "jsCode": "function title(p){return (p?.title??[]).map(x=>x.plain_text??'').join('')}function text(p){return (p?.rich_text??[]).map(x=>x.plain_text??'').join('')}function sel(p){return p?.select?.name??''}function rel(p){return (p?.relation??[]).map(x=>x.id)}return ($json.results??[]).map(i=>{const p=i.properties??{};const typ=sel(p['Type incident'])||'Autre';const id='incident:'+i.id.replaceAll('-','')+':'+typ.toLowerCase();return {json:{intervention_id:i.id,name:title(p.Intervention)||i.id,type:typ,description:text(p['Description incident'])||'Incident signalé sans description',action:text(p['Action corrective'])||'Analyser et définir une action corrective',reservation_ids:rel(p['Réservation liée']),automation_id:id}}});"
      },
