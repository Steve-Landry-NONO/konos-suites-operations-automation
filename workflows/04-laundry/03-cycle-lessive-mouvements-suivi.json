        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({\n  parent: {\n    data_source_id: \"4b7d29cf-082a-4135-8695-6e638e20dd26\"\n  },\n  properties: {\n    \"Mouvement\": {\n      title: [\n        {\n          type: \"text\",\n          text: {\n            content: $json.movement_type + \" — cycle de lessive\"\n          }\n        }\n      ]\n    },\n    \"Date mouvement\": {\n      date: {\n        start: new Date().toISOString().slice(0, 10)\n      }\n    },\n    \"Type mouvement\": {\n      select: {\n        name: $json.movement_type\n      }\n    },\n    \"Quantité\": {\n      number: $json.quantity\n    },\n    \"Article linge\": {\n      relation: [\n        {\n          id: $json.article_page_id\n        }\n      ]\n    },\n    \"Intervention liée\": {\n      relation: [\n        {\n          id: $json.intervention_page_id\n        }\n      ]\n    },\n    \"Statut\": {\n      select: {\n        name: \"Confirmé\"\n      }\n    },\n    \"Créé par\": {\n      select: {\n        name: \"n8n\"\n      }\n    },\n    \"ID automatisation\": {\n      rich_text: [\n        {\n          type: \"text\",\n          text: {\n            content: $json.automation_id\n          }\n        }\n      ]\n    },\n    \"Commentaire\": {\n      rich_text: [\n        {\n          type: \"text\",\n          text: {\n            content: \"Étape créée automatiquement depuis le statut du cycle de lessive.\"\n          }\n        }\n      ]\n    }\n  }\n}) }}",
        "options": {}
      },
