      "id": "992a0faf-8fcc-4a84-ad50-94fd1741bacb",
      "name": "Toutes les 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -1568,
        32
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/data_sources/d963222e-f8ef-4575-9ff1-c1e3bfd2ced7/query",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2026-03-11"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "{\n  \"page_size\": 100,\n  \"filter\": {\n    \"or\": [\n      {\n        \"property\": \"Statut\",\n        \"select\": {\n          \"equals\": \"Lavage en cours\"\n        }\n      },\n      {\n        \"property\": \"Statut\",\n        \"select\": {\n          \"equals\": \"À sécher\"\n        }\n      },\n      {\n        \"property\": \"Statut\",\n        \"select\": {\n          \"equals\": \"Séchage en cours\"\n        }\n      },\n      {\n        \"property\": \"Statut\",\n        \"select\": {\n          \"equals\": \"À ranger\"\n        }\n      },\n      {\n        \"property\": \"Statut\",\n        \"select\": {\n          \"equals\": \"Terminé\"\n        }\n      }\n    ]\n  }\n}",
        "options": {}
      },
      "id": "44f3c9ad-2eab-495a-a2ae-606a366416f4",
      "name": "Lire cycles à synchroniser",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1360,
        32
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "nEXSVkeOTN9rwZBZ",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const map={\n'Lavage en cours':'Lavage lancé',\n'À sécher':'Lavage terminé',\n'Séchage en cours':'Séchage lancé',\n'À ranger':'Séchage terminé',\n'Terminé':'Rangé propre'\n};\nreturn ($json.results??[]).flatMap(c=>{\n const statut=c.properties?.Statut?.select?.name;\n const type=map[statut];\n const ids=(c.properties?.['Mouvements liés']?.relation??[]).map(x=>x.id);\n if(!type||!ids.length)return [];\n return ids.map(id=>({json:{\n   cycle_page_id:c.id,\n   cycle_status:statut,\n   movement_type:type,\n   source_movement_id:id\n }}));\n});"
      },
      "id": "5cee72e1-9969-4537-bfd2-ee89760dcdca",
      "name": "Préparer étapes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1168,
        32
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "36f990bb-60b5-4431-8a7d-e17003848911",
      "name": "Traiter chaque article",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -960,
        32
      ]
    },
    {
      "parameters": {
        "url": "={{ \"https://api.notion.com/v1/pages/\" + $json.source_movement_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2026-03-11"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "49240a47-56e0-4fc5-8b3c-e6e1e82017f5",
      "name": "Lire mouvement source",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -768,
        32
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "nEXSVkeOTN9rwZBZ",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const c=$('Traiter chaque article').item.json;\nconst p=$json.properties??{};\nconst a=p['Article linge']?.relation?.[0]?.id;\nconst i=p['Intervention liée']?.relation?.[0]?.id;\nconst q=p['Quantité']?.number??0;\nconst aid=['cycle-etape',c.cycle_page_id.replaceAll('-',''),c.movement_type,c.source_movement_id.replaceAll('-','')].join(':');\nreturn [{json:{...c,article_page_id:a,intervention_page_id:i,quantity:q,automation_id:aid,valid:!!a&&!!i&&q>0}}];"
      },
      "id": "59036c93-987b-437b-b00d-a0430888ee0f",
      "name": "Préparer mouvement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -560,
        32
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/data_sources/4b7d29cf-082a-4135-8695-6e638e20dd26/query",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2026-03-11"
