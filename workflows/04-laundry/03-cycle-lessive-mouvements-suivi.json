        "body": "={{ JSON.stringify({\n  page_size: 1,\n  filter: {\n    property: \"ID automatisation\",\n    rich_text: {\n      equals: $json.automation_id\n    }\n  }\n}) }}",
        "options": {}
      },
      "id": "411999b6-e5ee-4f96-980a-f6d8be6da9a9",
      "name": "Chercher étape existante",
