      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/data_sources/4b7d29cf-082a-4135-8695-6e638e20dd26/query",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2026-03-11"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({\n  page_size: 100,\n  filter: {\n    and: [\n      {\n        or: $json.intervention_ids.map(id => ({\n          property: \"Intervention liée\",\n          relation: {\n            contains: id\n          }\n        }))\n      },\n      {\n        property: \"Type mouvement\",\n        select: {\n          equals: \"Installation logement\"\n        }\n      },\n      {\n        property: \"Statut\",\n        select: {\n          equals: \"Confirmé\"\n        }\n      }\n    ]\n  }\n}) }}",
        "options": {}
      },
      "id": "54265808-427a-4a27-9f8e-1a705e2db90f",
      "name": "Lire linge installé",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -912,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "nEXSVkeOTN9rwZBZ",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst source = $('Traiter chaque départ').item.json;\nconst output = [];\n\nfor (const page of ($json.results ?? [])) {\n  const p = page.properties ?? {};\n  const articleRelation = p['Article linge']?.relation ?? [];\n  const interventionRelation = p['Intervention liée']?.relation ?? [];\n  const qty = p['Quantité']?.number ?? 0;\n  if (!articleRelation.length || !interventionRelation.length || qty <= 0) continue;\n\n  output.push({\n    json: {\n      reservation_page_id: source.reservation_page_id,\n      reservation_name: source.reservation_name,\n      departure_date: source.departure_date,\n      source_installation_page_id: page.id,\n      article_page_id: articleRelation[0].id,\n      intervention_page_id: interventionRelation[0].id,\n      quantity: qty,\n      automation_id: 'retour-sale:' + page.id.replaceAll('-', ''),\n      movement_title: 'Retour sale — ' + source.reservation_name\n    }\n  });\n}\nreturn output;\n"
      },
