    {
      "parameters": {
        "jsCode": "\nfunction title(prop) {\n  return prop?.title?.map(x => x.plain_text ?? x.text?.content ?? '').join('') ?? '';\n}\nfunction dateStart(prop) {\n  return prop?.date?.start ?? new Date().toISOString().slice(0, 10);\n}\n\nconst output = [];\nfor (const page of ($json.results ?? [])) {\n  const interventions = page.properties?.['Interventions']?.relation ?? [];\n  if (!interventions.length) continue;\n\n  output.push({\n    json: {\n      reservation_page_id: page.id,\n      reservation_name: title(page.properties?.['Réservation']) || page.id,\n      departure_date: dateStart(page.properties?.['Départ']),\n      intervention_ids: interventions.map(x => x.id),\n    }\n  });\n}\nreturn output;\n"
      },
      "id": "eaf75330-b4be-4ed9-9359-65d3b7c42d5d",
      "name": "Préparer les départs",
