    {
      "parameters": {
        "jsCode": "\nfunction title(prop) {\n  return prop?.title?.map(x => x.plain_text ?? x.text?.content ?? '').join('') ?? '';\n}\nfunction dateStart(prop) {\n  return prop?.date?.start ?? new Date().toISOString().slice(0, 10);\n}\nreturn ($json.results ?? []).map(page => ({\n  json: {\n    reservation_page_id: page.id,\n    reservation_name: title(page.properties?.['Réservation']) || page.id,\n    departure_date: dateStart(page.properties?.['Départ']),\n    intervention_ids: (page.properties?.['Interventions']?.relation ?? []).map(x => x.id),\n    cycle_automation_id: 'cycle-lessive:' + page.id.replaceAll('-', '')\n  }\n})).filter(x => x.json.intervention_ids.length > 0);\n"
      },
