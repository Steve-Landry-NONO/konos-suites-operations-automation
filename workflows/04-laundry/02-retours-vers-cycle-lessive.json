        "body": "={\n  \"page_size\": 100,\n  \"filter\": {\n    \"and\": [\n      {\n        \"property\": \"Départ confirmé\",\n        \"checkbox\": {\n          \"equals\": true\n        }\n      },\n      {\n        \"property\": \"Retour linge traité\",\n        \"checkbox\": {\n          \"equals\": false\n        }\n      }\n    ]\n  }\n}",
