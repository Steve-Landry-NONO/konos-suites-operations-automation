      "parameters": {
        "jsCode": "\nconst source = $('Créer le cycle ?').item.json;\nconst pages = $json.results ?? [];\nconst quantity = pages.reduce((sum, p) => sum + (p.properties?.['Quantité']?.number ?? 0), 0);\nreturn [{\n  json: {\n    ...source,\n    movement_ids: pages.map(p => p.id),\n    total_quantity: quantity,\n    has_returns: pages.length > 0\n  }\n}];\n"
